[worldserver]

###################################################################################################
# PLAYERBOTS PLUS
#
#    PlayerbotsPlus.Enable
#        Description: Master switch. Strategies still need to be enabled per bot, e.g.
#                     AiPlayerbot.NonCombatStrategies = "+errands" in playerbots.conf.
#        Default:     1

PlayerbotsPlus.Enable = 1

###################################################################################################
# ERRANDS
#
# When its master stands still, an altbot turns in / accepts quests, repairs and sells junk
# at NPCs near the master, then resumes following. Distances in yards, times in ms.
#
#    PlayerbotsPlus.Errands.Radius           Radius around the master.            Default: 20
#    PlayerbotsPlus.Errands.IdleDelay        Master stillness before starting.    Default: 3000
#    PlayerbotsPlus.Errands.Timeout          Max time per errand.                 Default: 20000
#    PlayerbotsPlus.Errands.Blacklist        Ignore a failed target / rest a
#                                            visited vendor for this long.        Default: 60000
#    PlayerbotsPlus.Errands.RepairThreshold  Repair below this durability %.      Default: 30
#    PlayerbotsPlus.Errands.SellWhite        Also sell white weapons and armor.   Default: 0
#    PlayerbotsPlus.Errands.MaxSellQuality   Highest quality sold when neither the
#                                            bot nor the group has a use for the
#                                            item: 0 grey, 1 white, 2 green,
#                                            3 blue, 4 epic.                      Default: 3
#    PlayerbotsPlus.Errands.SellFood         Also sell food and drink no recipe
#                                            makes, for bots with the "food" cheat
#                                            (they never eat items).              Default: 1
#    PlayerbotsPlus.Errands.InInstances      Allow errands in dungeons/raids/BGs. Default: 0

PlayerbotsPlus.Errands.Radius = 20
PlayerbotsPlus.Errands.IdleDelay = 3000
PlayerbotsPlus.Errands.Timeout = 20000
PlayerbotsPlus.Errands.Blacklist = 60000
PlayerbotsPlus.Errands.RepairThreshold = 30
PlayerbotsPlus.Errands.SellWhite = 0
PlayerbotsPlus.Errands.MaxSellQuality = 3
PlayerbotsPlus.Errands.SellFood = 1
PlayerbotsPlus.Errands.InInstances = 0

###################################################################################################
# ERRANDS HUNT  (strategy "errands hunt", on top of "errands")
#
# When the master is idle and no errand is left, one bot of the group (a tank first) pulls
# a quest mob near the master; the group fights it as usual.
#
#    PlayerbotsPlus.Hunt.Radius         Yd from the master. Wider than the
#                                       errands radius: closer mobs aggro
#                                       before the master is idle.              Default: 45
#    PlayerbotsPlus.Hunt.MaxLevelAbove  Max levels above the lowest group bot.  Default: 2
#    PlayerbotsPlus.Hunt.PackRadius     Other hostiles this close (yd) veto
#                                       the pull.                               Default: 8

PlayerbotsPlus.Hunt.Radius = 45
PlayerbotsPlus.Hunt.MaxLevelAbove = 2
PlayerbotsPlus.Hunt.PackRadius = 8

###################################################################################################
# ERRANDS BAGS  (strategy "errands bags")
#
# Out of combat, an alt below this many free bag slots gives stackable items to a nearby
# alt (merging into partial stacks first).
#
#    PlayerbotsPlus.Bags.MinFreeSlots   Free slots each alt tries to keep.      Default: 1

PlayerbotsPlus.Bags.MinFreeSlots = 1

###################################################################################################
# ERRANDS CRAFT  (strategy "errands craft")
#
#    PlayerbotsPlus.Craft.MaxDisenchantQuality  Highest quality an enchanter bot
#                                               disenchants when nobody (you included)
#                                               wants the item: 2 green, 3 blue, 4 epic. Default: 3

PlayerbotsPlus.Craft.MaxDisenchantQuality = 3
